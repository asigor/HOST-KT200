## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Local host data
.localhost/

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/

# Visual Studio cache/options
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# Local Environment files
.env
.env.local

# Rider
.idea/
*.sln.iml

# Logs
*.log
logs/
